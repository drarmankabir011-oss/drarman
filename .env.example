APP_NAME=Dr. Arman Kabir's Care
APP_ENV=production
APP_DEBUG=false

# Database
DB_HOST=localhost
DB_NAME=drarmankabir_db
DB_USER=cpanel_user
DB_PASSWORD=strong_password

# JWT
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# Email
MAIL_HOST=smtp.cPanel.host
MAIL_PORT=465
MAIL_FROM=noreply@clinic.com
MAIL_USERNAME=email@clinic.com
MAIL_PASSWORD=email_password

# WhatsApp (Twilio)
TWILIO_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_NUMBER=+1234567890

# Frontend
FRONTEND_URL=https://yourhealth.clinic

# File Upload
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=pdf,doc,docx,jpg,png
UPLOAD_PATH=/uploads/

# API
API_RATE_LIMIT=100
API_RATE_WINDOW=3600
