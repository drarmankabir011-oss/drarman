{
  "name": "drarmankabir/api",
  "description": "Dr. Arman Kabir Care - PHP Backend",
  "type": "project",
  "require": {
    "php": "^8.1",
    "firebase/php-jwt": "^6.0",
    "vlucas/phpdotenv": "^5.5",
    "monolog/monolog": "^2.0",
    "guzzlehttp/guzzle": "^7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "phpstan/phpstan": "^1.9",
    "squizlabs/php_codesniffer": "^3.7"
  },
  "autoload": {
    "psr-4": {
      "Config\\": "src/config/",
      "Models\\": "src/models/",
      "Controllers\\": "src/controllers/",
      "Middleware\\": "src/middleware/",
      "Services\\": "src/services/",
      "Utils\\": "src/utils/"
    }
  }
}
